# ─────────────────────────────────────────────────────────────────────────────
# Lead Generation Agent — environment configuration template
#
# Copy this file to `.env` and adjust the values. `.env` is git-ignored and is
# loaded automatically at startup.
# ─────────────────────────────────────────────────────────────────────────────

# Browser automation
PLAYWRIGHT_HEADLESS=False
PLAYWRIGHT_TIMEOUT=30000
BROWSER_TYPE=chromium
# Artificial delay (ms) between browser actions, useful when debugging. The
# default is 300; setting 0 disables the delay only when running headless
# (headed mode always applies a 300 ms delay).
BROWSER_SLOW_MO=300

# How many businesses to collect (default 5; a run never exceeds 10 without an
# explicit count in the prompt, e.g. "collect 50 software companies")
LEAD_MAX_RESULTS=5

# Backward-compatible aliases (the legacy names still work and take effect only
# when the new names above are not set):
#   HEADLESS            -> same as PLAYWRIGHT_HEADLESS
#   TIMEOUT             -> same as PLAYWRIGHT_TIMEOUT
#   MAX_LEADS           -> same as LEAD_MAX_RESULTS
#   SEARCH_PROVIDER, OUTPUT_DIR, LOG_DIR, LOG_LEVEL
SEARCH_PROVIDER=google
OUTPUT_DIR=outputs
LOG_DIR=logs
LOG_LEVEL=INFO

# Desktop GUI theme: "dark" (default) or "light"
GUI_THEME=dark

# ─────────────────────────────────────────────────────────────────────────────
# AI Agent / Offline mode
# ─────────────────────────────────────────────────────────────────────────────
# The application uses ONE unified LLM gateway: the FreeLLM Router, an
# OpenAI-compatible endpoint that unlocks many free models with a single API key.
#
# AI Agent Mode  = ENABLE_LLM=true  AND FREELLM_API_KEY is set.
# Offline Mode   = ENABLE_LLM=false OR  FREELLM_API_KEY is empty.
#
# In Offline Mode the agent uses the deterministic parser, skips LLM reasoning,
# and keeps browser automation + Excel export working with no network calls.
#
# How to obtain a key: run/point your FreeLLM Router instance, then paste your
# API key below. Leave FREELLM_API_KEY blank (as below) to run in Offline Mode.
ENABLE_LLM=true
LLM_PROVIDER=freellm
FREELLM_API_KEY=
FREELLM_BASE_URL=http://localhost:3001/v1

# LLM_MODEL must stay "auto". The FreeLLM Router performs ALL model selection,
# retries, provider rotation, fallback, rate-limit recovery, and load balancing
# server-side; the application implements no client-side fallback chain and
# never names a concrete model.
LLM_MODEL=auto
